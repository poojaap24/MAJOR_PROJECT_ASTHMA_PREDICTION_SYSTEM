# ---- Air quality (existing) ----
# Get a free key at https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Optional - defaults to 5000 if not set
PORT=5000

# ---- Chatbot (Groq) ----
# Get a free key at https://console.groq.com/keys
# Leave blank to disable the chatbot; /api/chat will return a clear error instead of crashing.
GROQ_API_KEY=

# ---- Login / signup ----
# Accounts are stored in a local SQLite file (backend/auth/auth.db), created automatically.
# Nothing to install. Optional: AUTH_DB_PATH=C:/some/other/place/auth.db

# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# They must be two DIFFERENT long random strings.
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d